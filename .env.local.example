# Shopify Storefront API (public - peut être exposé côté client)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=vztmja-iy.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_token_here

# Shopify API Version
SHOPIFY_API_VERSION=2025-01

# Shopify Admin API (serveur uniquement — client credentials grant, token
# régénéré à chaque appel). Requis pour l'estimation par e-mail
# (création client + draft order + invoice).
SHOPIFY_ADMIN_CLIENT_ID=your_admin_client_id
SHOPIFY_ADMIN_CLIENT_SECRET=your_admin_client_secret

# Code promo -15% du calculateur (lu côté serveur, injecté dans cartCreate et le cart permalink — jamais affiché)
DISCOUNT_CODE=PROMO-APP-CALCULATEUR

# Clé privée Klaviyo (serveur uniquement, jamais NEXT_PUBLIC_) — événement
# "Estimation calculateur demandée" envoyé après chaque estimation.
# Absente : l'envoi est ignoré avec un warning, l'estimation aboutit quand même.
KLAVIYO_PRIVATE_API_KEY=pk_your_klaviyo_private_key

# Token Wizart (simulateur de teintes) — public par nature : il est transmis au
# navigateur par le script hébergé /embed/colibri.js. Vide : aucune entrée vers
# le simulateur. Lu au build : redéployer après tout ajout ou changement.
NEXT_PUBLIC_WIZART_TOKEN=

# Propriété GA4 de la boutique (ex. G-XXXXXXXXXX) — publique par nature : le
# script hébergé /embed/colibri.js envoie les événements du simulateur et du
# calculateur avec le gtag déjà chargé par la page Shopify (send_to = cet ID,
# consentement géré par la boutique). Vide : aucun événement. Lu au build :
# redéployer après tout ajout ou changement.
NEXT_PUBLIC_GA4_ID=
